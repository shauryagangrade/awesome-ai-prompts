root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
# Markdown indentation is contextual (list continuations, fenced code
# blocks); do not enforce the repo-wide 2-space indent on it.
indent_style = unset
indent_size = unset

[Makefile]
indent_style = tab
